# Razorpay test mode credentials (rzp_test_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Mandate signing keypair (Ed25519, base64 PKCS8 / SPKI)
MANDATE_PRIVATE_KEY=
MANDATE_PUBLIC_KEY=

MERCHANT_ID=mrc_mandi_demo
MERCHANT_NAME=Mandi Provisions
PUBLIC_BASE_URL=http://localhost:3000
DB_PATH=./mandi.db

# Remote MCP endpoint (leave unset to keep /api/mcp disabled)
MCP_BEARER_TOKEN=
MCP_OAUTH_APPROVAL_TOKEN=
MCP_OAUTH_SIGNING_SECRET=
# Public HTTPS origin from ngrok or your deployment, without `/api/mcp`.
MCP_PUBLIC_BASE_URL=

# Optional private origin used by `/api/try` when this app is deployed behind a proxy.
INTERNAL_BASE_URL=

# Optional purchase receipt email. A missing/invalid key never blocks checkout.
RESEND_API_KEY=
# Use a verified Resend sender in production. The default is Mandi <onboarding@resend.dev>.
RESEND_FROM=
# Optional overrides for the video-demo recipient (defaults to Vaibhav Kothari).
RECEIPT_TO_EMAIL=
RECEIPT_TO_NAME=
